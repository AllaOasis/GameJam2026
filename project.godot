; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Toxicorp Five"
config/description="Alright, team Five.

Count Dracula himself has sought us out for this one. His castle has been overrun by the Pollutants and now he wants us to clean up the place. He's promised to pay us in solid gold, so I don't have to tell you what's at stake here. You know the drill: go in, foam up the place, get rid of the Pollutants, decontaminate the area, and don't irradiate yourself."
config/version="alpha 1.0.0"
run/main_scene="uid://dodyq4d6gm02c"
config/custom_user_dir_name="toxicorp_fives"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.08235294, 0.08235294, 0.08235294, 1)
boot_splash/stretch_mode=2
boot_splash/use_filter=false
boot_splash/image="uid://b4rkl3u8i4j16"
config/icon="uid://iud5lfp5pv3n"
config/macos_native_icon="uid://iud5lfp5pv3n"
config/windows_native_icon="uid://iud5lfp5pv3n"
boot_splash/minimum_display_time=2500

[autoload]

SceneManager="*uid://doaaig2tawmgc"
PauseManager="*uid://8xfkrlw2u722"
GameData="*uid://bd5nsbfhawa54"

